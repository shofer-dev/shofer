load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "sandbox_lib",
    srcs = ["main.go"],
    importpath = "github.com/arkware/ai/extensions/shofer/src/sandbox",
    visibility = ["//visibility:private"],
    deps = ["@org_golang_x_sys//unix"],
)

go_binary(
    name = "sandbox",
    embed = [":sandbox_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "sandbox_test",
    srcs = ["main_test.go"],
    embed = [":sandbox_lib"],
)
