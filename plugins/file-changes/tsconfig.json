{
	"//": "Standalone tsconfig for the File Changes plugin. Its entry is TypeScript the host bundles at load time, so the sources sit OUTSIDE every extension/package tsc root. This config exists so a developer/CI can typecheck the plugin against the public @shofer/types surface in isolation: `npx tsgo -p plugins/file-changes`.",
	"extends": "@shofer/config-typescript/base.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node"],
		"jsx": "react-jsx",
		// The UI half is bundled, not emitted, and it imports the kit's source — so this
		// project resolves like the webview does rather than like Node ESM.
		"module": "esnext",
		"moduleResolution": "bundler",
		"typeRoots": [
			"../../webview-ui/node_modules/@types",
			"../../packages/core/node_modules/@types",
			"../../node_modules/@types"
		],
		"paths": {
			"@shofer/types": ["../../packages/types/src/index.ts"],
			"@shofer/plugin-ui": ["../plugin-ui.d.ts"],
			"react": ["../../webview-ui/node_modules/@types/react"],
			"react/jsx-runtime": ["../../webview-ui/node_modules/@types/react/jsx-runtime"],
			"react-dom": ["../../webview-ui/node_modules/@types/react-dom"]
		}
	},
	"include": ["src/*.ts", "src/vendor/*.d.mts", "ui/*.tsx"],
	"exclude": ["node_modules", "__tests__", "vitest.config.ts"]
}
