{
	"name": "@shofer/types",
	"version": "0.0.7",
	"type": "module",
	"main": "./dist/index.cjs",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./dist/index.js",
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"scripts": {
		"lint": "eslint src --ext=ts --max-warnings=0",
		"check-types": "tsgo --noEmit",
		"test": "vitest run",
		"build": "tsup",
		"build:watch": "tsup --watch --outDir npm/dist --onSuccess 'echo ✅ Types rebuilt to npm/dist'",
		"npm:publish": "node scripts/publish-npm.cjs",
		"clean": "rimraf dist .turbo",
		"generate:schema": "tsx scripts/generate-shofermodes-schema.ts && tsx scripts/generate-settings-schema.ts"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.37.0",
		"ai-sdk-provider-poe": "2.0.18",
		"shell-quote": "^1.10.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@shofer/config-eslint": "workspace:^",
		"@shofer/config-typescript": "workspace:^",
		"@types/node": "^24.1.0",
		"@types/shell-quote": "^1.7.5",
		"@vitest/coverage-v8": "^3.2.7",
		"ajv": "^8.20.0",
		"globals": "^16.3.0",
		"tsup": "^8.4.0",
		"vitest": "^3.2.7",
		"zod-to-json-schema": "^3.25.1"
	}
}
